# ============================
# Database configuration
# ============================
db.driver=org.postgresql.Driver
db.url=jdbc:postgresql://postgres-service:5432/obp_api_db
db.user=obp_api_user
db.password=${POSTGRES_PASSWORD}   # injecté par secret dans Kubernetes

# ============================
# Application settings
# ============================
obp.environment=development
obp.port=8080

# logging level (DEBUG / INFO / WARN / ERROR)
obp.log.level=INFO

# timezone
obp.timezone=UTC

# ============================
# Liftweb / OBP API Settings
# ============================
# If no external props folder is mounted, fallback to this default
props.resource=default.props
