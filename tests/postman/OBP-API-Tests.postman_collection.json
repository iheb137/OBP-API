  "item": [
    {
      "name": "Authentification",
      "item": [
        {
          "name": "Direct Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Token reçu\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.token).to.exist;",
                  "    pm.environment.set(\"authToken\", jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "DirectLogin username=\"{{username}}\", password=\"{{password}}\", consumer_key=\"{{consumer_key}}\""
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/my/logins/direct",
              "host": ["{{baseUrl}}"],
              "path": ["my", "logins", "direct"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Banques",
      "item": [
        {
          "name": "Liste des banques",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Banques reçues\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.banks).to.exist;",
                  "    pm.expect(jsonData.banks).to.be.an(\"array\");",
                  "    if (jsonData.banks.length > 0) {",
                  "        pm.environment.set(\"bank_id\", jsonData.banks[0].id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "DirectLogin token={{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/obp/v5.0.0/banks",
              "host": ["{{baseUrl}}"],
              "path": ["obp", "v5.0.0", "banks"]
            }
          },
          "response": []
        },
        {
          "name": "Détails d'une banque",
          "event": [
            {
